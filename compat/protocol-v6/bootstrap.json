{
  "manifest": {
    "identifier": "com.pushin.compat",
    "name": "Pam Compatibility",
    "version": "1.0.0",
    "description": "Protocol 6 compatibility fixture.",
    "publisher": "Pushin",
    "category": 1,
    "icon": "resources/icon.svg",
    "bundleExcludes": [],
    "lifecycle": {
      "urlSchemes": [],
      "mimeTypes": [],
      "autostart": false
    }
  },
  "windows": [
    {
      "id": "main",
      "entry": "resources/index.html",
      "title": "Compatibility",
      "width": 1024,
      "height": 720,
      "minWidth": 640,
      "minHeight": 480,
      "resizable": true,
      "visible": true,
      "theme": 3,
      "decorated": true,
      "transparent": false,
      "alwaysOnTop": false,
      "maximized": false,
      "fullscreen": false
    }
  ],
  "commandTimeoutMs": 10000,
  "parallelWorkerCount": 2,
  "commands": [],
  "capabilities": {
    "filesystemRoots": [
      {
        "name": "data",
        "path": "storage",
        "access": 3
      }
    ],
    "dialogs": true,
    "clipboardRead": true,
    "clipboardWrite": true,
    "notifications": true,
    "dragAndDrop": true,
    "databases": [],
    "systemInformation": false,
    "httpOrigins": [],
    "secrets": false,
    "processes": [],
    "desktopPortal": false
  },
  "shell": {
    "menus": [
      {
        "id": "application",
        "label": "Application",
        "items": [
          {
            "kind": 1,
            "id": "show",
            "label": "Show",
            "enabled": true,
            "checked": false,
            "accelerator": "CmdOrCtrl+Shift+KeyP",
            "items": []
          },
          {
            "kind": 3,
            "id": "",
            "label": "",
            "enabled": true,
            "checked": false,
            "items": []
          },
          {
            "kind": 2,
            "id": "background",
            "label": "Background",
            "enabled": true,
            "checked": true,
            "items": []
          }
        ]
      }
    ],
    "tray": {
      "menuId": "application",
      "tooltip": "Pam Compatibility",
      "closeBehavior": 2
    },
    "shortcuts": [
      {
        "id": "show",
        "accelerator": "CmdOrCtrl+Shift+KeyP"
      }
    ],
    "quickActions": []
  },
  "backgroundJobs": [
    {
      "id": "heartbeat",
      "intervalMs": 30000,
      "initialDelayMs": 1000,
      "timeoutMs": 3000,
      "overlap": 1
    }
  ],
  "rustPlugins": [
    {
      "id": "system.info",
      "executable": "plugins/bin/system.info",
      "arguments": [],
      "timeoutMs": 5000
    }
  ],
  "phpPlugins": [
    "compat.php"
  ]
}
