{
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "platform-check": true,
    "sort-packages": true
  },
  "description": "A PAM Desktop application",
  "license": "proprietary",
  "name": "app/slack",
  "require": {
    "php": "^8.5",
    "pushinbr/pam-desktop": "^2.1.8"
  },
  "scripts": {
    "build": "pam-desktop build",
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "pam-desktop dev"
    ],
    "start": "pam-desktop run",
    "test": "@php tests/SlackTest.php"
  },
  "type": "project"
}
