{
    "name": "pushinbr/pam-desktop",
    "description": "Build fast native Linux, macOS and Windows applications with PHP and PAM.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/push-in/pam-desktop",
    "keywords": [
        "desktop",
        "native",
        "pam",
        "php",
        "gtk",
        "appkit",
        "windows"
    ],
    "require": {
        "php": "^8.5",
        "symfony/polyfill-intl-normalizer": "^1.43"
    },
    "suggest": {
        "bacon/bacon-qr-code": "Required by Pam\\Desktop\\Qr (^3.1.1)"
    },
    "autoload": {
        "files": [
            "packages/desktop/src/Polyfill/mbstring_functions.php",
            "packages/desktop/src/Routing/functions.php",
            "packages/desktop/src/functions.php",
            "packages/desktop/src/Testing/functions.php"
        ],
        "psr-4": {
            "Pam\\Desktop\\": "packages/desktop/src/",
            "Pam\\Desktop\\Canvas\\": "packages/canvas/src/",
            "Pam\\Desktop\\Charts\\": "packages/charts/src/",
            "Pam\\Desktop\\Code\\": "packages/code/src/",
            "Pam\\Desktop\\Markdown\\": "packages/markdown/src/",
            "Pam\\Desktop\\Qr\\": "packages/qr/src/",
            "Pam\\Desktop\\Realtime\\": "packages/realtime/src/",
            "Pam\\Desktop\\Sync\\Durable\\": "packages/sync/src/",
            "Pam\\DesktopPrinting\\": "packages/desktop-printing/src/",
            "Pam\\DesktopUi\\": "packages/desktop-ui/src/"
        }
    },
    "bin": [
        "packages/desktop/bin/pam-desktop"
    ],
    "extra": {
        "pam": {
            "commands": {
                "desktop": {
                    "bin": "packages/desktop/bin/pam-desktop",
                    "description": "Build, run and diagnose PAM Desktop applications"
                }
            }
        }
    },
    "support": {
        "issues": "https://github.com/push-in/pam-desktop/issues",
        "source": "https://github.com/push-in/pam-desktop"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    }
}
