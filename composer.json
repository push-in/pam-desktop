{
    "name": "pushinbr/pam-desktop",
    "description": "Elegant PHP-first desktop applications powered by Pam, Rust, and Servo.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/push-in/pam-desktop",
    "keywords": [
        "desktop",
        "pam",
        "php",
        "rust",
        "servo"
    ],
    "require": {
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Desktop\\": "packages/desktop/src/"
        }
    },
    "bin": [
        "packages/desktop/bin/pam-desktop"
    ],
    "support": {
        "issues": "https://github.com/push-in/pam-desktop/issues",
        "source": "https://github.com/push-in/pam-desktop"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    }
}
