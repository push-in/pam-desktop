#!/usr/bin/env php
<?php

declare(strict_types=1);

const HOST_VERSION = '1.3.0';
const REPOSITORY = 'push-in/pam-desktop';
const MAX_ARCHIVE_BYTES = 536_870_912;
const MAX_EXTRACTED_BYTES = 1_073_741_824;

function fail(string $message): never
{
    fwrite(STDERR, "pam-desktop: {$message}\n");
    exit(1);
}

function target(): string
{
    $machine = strtolower(php_uname('m'));
    $architecture = match ($machine) {
        'x86_64', 'amd64' => 'x86_64',
        'arm64', 'aarch64' => 'aarch64',
        default => fail("unsupported architecture {$machine}"),
    };
    return match (PHP_OS_FAMILY) {
        'Linux' => $architecture === 'x86_64' ? 'x86_64-unknown-linux-gnu' : 'aarch64-unknown-linux-gnu',
        'Darwin' => "{$architecture}-apple-darwin",
        'Windows' => $architecture === 'x86_64' ? 'x86_64-pc-windows-msvc' : 'aarch64-pc-windows-msvc',
        default => fail('the native desktop host supports Linux, macOS and Windows'),
    };
}

function absolutePath(string $path): bool
{
    return PHP_OS_FAMILY === 'Windows'
        ? preg_match('/^(?:[A-Za-z]:[\\\\\/]|\\\\\\\\)/', $path) === 1
        : str_starts_with($path, '/');
}

/** @param list<string> $arguments */
function execute(string $binary, array $arguments): never
{
    $process = proc_open([$binary, ...$arguments], [STDIN, STDOUT, STDERR], $pipes, null, null, ['bypass_shell' => true]);
    if (!is_resource($process)) {
        fail("cannot start native host {$binary}");
    }
    $status = proc_close($process);
    exit($status === -1 ? 1 : $status);
}

function removeTree(string $directory): void
{
    if (!is_dir($directory) || is_link($directory)) {
        return;
    }
    foreach (new FilesystemIterator($directory, FilesystemIterator::SKIP_DOTS) as $entry) {
        $path = $entry->getPathname();
        if ($entry->isDir() && !$entry->isLink()) {
            removeTree($path);
        } else {
            @unlink($path);
        }
    }
    @rmdir($directory);
}

function pruneCache(string $root, string $current): void
{
    if (!is_dir($root)) {
        return;
    }
    $versions = [];
    foreach (new FilesystemIterator($root, FilesystemIterator::SKIP_DOTS) as $entry) {
        if (!$entry->isDir() || $entry->isLink()) {
            continue;
        }
        $name = $entry->getFilename();
        if (str_starts_with($name, '.download-') && $entry->getMTime() < time() - 86_400) {
            removeTree($entry->getPathname());
        } elseif ($name !== $current && preg_match('/^\d+\.\d+\.\d+(?:[.+-][0-9A-Za-z.-]+)?$/', $name) === 1) {
            $versions[] = ['path' => $entry->getPathname(), 'mtime' => $entry->getMTime()];
        }
    }
    usort($versions, static fn (array $left, array $right): int => $right['mtime'] <=> $left['mtime']);
    foreach (array_slice($versions, 2) as $stale) {
        removeTree($stale['path']);
    }
}

function download(string $url, string $destination): void
{
    $context = stream_context_create([
        'http' => ['follow_location' => 1, 'max_redirects' => 5, 'timeout' => 60],
        'ssl' => ['verify_peer' => true, 'verify_peer_name' => true, 'SNI_enabled' => true],
    ]);
    $input = @fopen($url, 'rb', false, $context);
    $output = @fopen($destination, 'xb');
    if ($input === false || $output === false) {
        if (is_resource($input)) {
            fclose($input);
        }
        fail("cannot download {$url}");
    }
    $bytes = stream_copy_to_stream($input, $output, MAX_ARCHIVE_BYTES + 1);
    fclose($input);
    fclose($output);
    if ($bytes === false || $bytes > MAX_ARCHIVE_BYTES) {
        @unlink($destination);
        fail('native host download exceeds the 512 MiB safety limit');
    }
}

function extractArchive(string $archive, string $work, string $package): string
{
    try {
        $compressed = new PharData($archive);
        $compressed->decompress();
        $tarPath = substr($archive, 0, -3);
        $tar = new PharData($tarPath);
        $prefix = 'phar://' . str_replace('\\', '/', $tarPath) . '/';
        $bytes = 0;
        foreach (new RecursiveIteratorIterator($tar) as $entry) {
            $path = str_replace('\\', '/', $entry->getPathname());
            $relative = str_starts_with($path, $prefix) ? substr($path, strlen($prefix)) : '';
            if ($relative === '' || str_starts_with($relative, '/') || preg_match('#(^|/)\.\.(/|$)#', $relative)) {
                fail('native host archive contains an unsafe path');
            }
            $bytes += $entry->getSize();
            if ($bytes > MAX_EXTRACTED_BYTES) {
                fail('native host archive exceeds the 1 GiB extraction limit');
            }
        }
        $tar->extractTo($work, null, false);
    } catch (Throwable $error) {
        fail("cannot extract native host archive: {$error->getMessage()}");
    }
    $directory = $work . DIRECTORY_SEPARATOR . $package;
    if (!is_dir($directory)) {
        fail('native host archive has no expected package directory');
    }
    return $directory;
}

$arguments = array_slice($argv, 1);
$override = getenv('PAM_DESKTOP_HOST_BINARY');
if (is_string($override) && $override !== '') {
    if (!absolutePath($override) || !is_file($override) || is_link($override)) {
        fail('PAM_DESKTOP_HOST_BINARY must be an absolute regular non-symlink file');
    }
    execute($override, $arguments);
}

$target = target();
$suffix = PHP_OS_FAMILY === 'Windows' ? '.exe' : '';
$cacheBase = getenv('PAM_DESKTOP_CACHE_DIR');
if (!is_string($cacheBase) || $cacheBase === '') {
    $cacheBase = match (PHP_OS_FAMILY) {
        'Windows' => (getenv('LOCALAPPDATA') ?: fail('LOCALAPPDATA is unavailable')) . '\\pam-desktop',
        'Darwin' => (getenv('HOME') ?: fail('HOME is unavailable')) . '/Library/Caches/pam-desktop',
        default => (getenv('XDG_CACHE_HOME') ?: (getenv('HOME') ?: fail('HOME is unavailable')) . '/.cache') . '/pam-desktop',
    };
}
if (!absolutePath($cacheBase)) {
    fail('the desktop host cache directory must be absolute');
}
$hostDirectory = $cacheBase . DIRECTORY_SEPARATOR . HOST_VERSION . DIRECTORY_SEPARATOR . $target;
$hostBinary = $hostDirectory . DIRECTORY_SEPARATOR . 'bin' . DIRECTORY_SEPARATOR . "pam-desktop{$suffix}";
pruneCache($cacheBase, HOST_VERSION);
if (is_file($hostBinary)) {
    execute($hostBinary, $arguments);
}
if (!extension_loaded('phar')) {
    fail('the PHP Phar extension is required for the first native host installation');
}
if (!is_dir($cacheBase) && !mkdir($cacheBase, 0700, true) && !is_dir($cacheBase)) {
    fail("cannot create native host cache {$cacheBase}");
}
$lockPath = $cacheBase . DIRECTORY_SEPARATOR . '.install-' . HOST_VERSION . "-{$target}.lock";
$lock = fopen($lockPath, 'c+b');
if ($lock === false || !flock($lock, LOCK_EX)) {
    fail('cannot acquire the native host installation lock');
}
if (is_file($hostBinary)) {
    flock($lock, LOCK_UN);
    fclose($lock);
    execute($hostBinary, $arguments);
}

$work = $cacheBase . DIRECTORY_SEPARATOR . '.download-' . HOST_VERSION . '-' . bin2hex(random_bytes(8));
if (!mkdir($work, 0700)) {
    fail('cannot create native host staging directory');
}
register_shutdown_function(static fn () => removeTree($work));
$package = 'pam-desktop-' . HOST_VERSION . "-{$target}";
$archiveName = "{$package}.tar.gz";
$release = 'https://github.com/' . REPOSITORY . '/releases/download/v' . HOST_VERSION;
$archive = $work . DIRECTORY_SEPARATOR . $archiveName;
$checksum = $archive . '.sha256';
fwrite(STDERR, 'pam-desktop: downloading verified host ' . HOST_VERSION . " for {$target}...\n");
download("{$release}/{$archiveName}", $archive);
download("{$release}/{$archiveName}.sha256", $checksum);
$expected = strtolower(strtok(trim((string) file_get_contents($checksum)), " \t"));
$actual = hash_file('sha256', $archive);
if (!is_string($actual) || strlen($expected) !== 64 || !hash_equals($expected, strtolower($actual))) {
    fail('native host archive checksum verification failed');
}
$packageDirectory = extractArchive($archive, $work, $package);
$candidate = $packageDirectory . DIRECTORY_SEPARATOR . 'bin' . DIRECTORY_SEPARATOR . "pam-desktop{$suffix}";
if (!is_file($candidate)) {
    fail('verified archive does not contain the native desktop host');
}
if (!is_dir(dirname($hostDirectory)) && !mkdir(dirname($hostDirectory), 0700, true) && !is_dir(dirname($hostDirectory))) {
    fail('cannot create the versioned native host cache');
}
if (!@rename($packageDirectory, $hostDirectory) && !is_file($hostBinary)) {
    fail('cannot atomically publish the native desktop host');
}
flock($lock, LOCK_UN);
fclose($lock);
@unlink($lockPath);
fwrite(STDERR, 'pam-desktop: host ' . HOST_VERSION . " ready.\n");
execute($hostBinary, $arguments);
