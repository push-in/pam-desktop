{
    "name": "pushinbr/pam-desktop",
    "description": "Build fast native Linux, macOS and Windows applications with PHP and PAM.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "symfony/polyfill-intl-normalizer": "^1.43"
    },
    "autoload": {
        "files": [
            "src/Polyfill/mbstring_functions.php",
            "src/Routing/functions.php",
            "src/functions.php",
            "src/Testing/functions.php"
        ],
        "psr-4": {
            "Pam\\Desktop\\": "src/"
        }
    },
    "bin": [
        "bin/pam-desktop"
    ],
    "extra": {
        "pam": {
            "commands": {
                "desktop": {
                    "bin": "bin/pam-desktop",
                    "description": "Build, run and diagnose PAM Desktop applications"
                }
            }
        }
    },
    "support": {
        "issues": "https://github.com/push-in/pam-desktop/issues",
        "source": "https://github.com/push-in/pam-desktop"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --configuration=phpstan.neon",
        "test": [
            "php tests/run.php"
        ]
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2"
    }
}
