{
    "name": "pushinbr/pam-desktop",
    "description": "Elegant PHP-first desktop applications powered by Pam, Rust, and Servo.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Desktop\\": "src/"
        }
    },
    "bin": [
        "bin/pam-desktop"
    ],
    "extra": {
        "pam": {
            "commands": {
                "desktop": {
                    "bin": "bin/pam-desktop",
                    "description": "Build, run and diagnose PAM Desktop applications"
                }
            }
        }
    },
    "support": {
        "issues": "https://github.com/push-in/pam-desktop/issues",
        "source": "https://github.com/push-in/pam-desktop"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist",
        "test": [
            "php tests/run.php",
            "php tests/compatibility.php"
        ]
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2"
    }
}
