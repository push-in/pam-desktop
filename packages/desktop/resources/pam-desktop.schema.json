{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://pam.dev/schemas/pam-desktop.v2.schema.json",
    "title": "PAM Desktop application manifest",
    "description": "pam-desktop.json: identity, first window, links and distribution of a PAM Desktop application. Every field is optional when running; pam-desktop build validates them.",
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string"
        },
        "applicationId": {
            "description": "Lowercase reverse-DNS name. It names the package, the desktop entry, the data directories and the update feed.",
            "type": "string",
            "maxLength": 155,
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "name": {
            "description": "The name shown to users.",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
        },
        "version": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[0-9][0-9A-Za-z.+~-]*$"
        },
        "build": {
            "type": "string",
            "maxLength": 64
        },
        "entry": {
            "description": "The script run, dev and the bundle start, relative to the project.",
            "type": "string",
            "default": "index.php"
        },
        "description": {
            "type": "string",
            "maxLength": 256
        },
        "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
        },
        "category": {
            "enum": ["development", "productivity", "graphics", "audio-video", "network", "utility", "game", "education"],
            "default": "utility"
        },
        "icon": {
            "description": "Project-relative PNG (square, 64 to 1024 px) or self-contained SVG.",
            "type": "string"
        },
        "window": {
            "description": "The first window.",
            "type": "object",
            "properties": {
                "title": { "type": "string" },
                "width": { "type": "number", "minimum": 1 },
                "height": { "type": "number", "minimum": 1 },
                "minWidth": { "type": "number", "minimum": 0 },
                "minHeight": { "type": "number", "minimum": 0 },
                "resizable": { "type": "boolean", "default": true }
            },
            "additionalProperties": false
        },
        "urlSchemes": {
            "description": "Schemes of the links that open the application.",
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9+.-]{1,31}$",
                "not": { "enum": ["http", "https", "file", "mailto", "javascript", "data"] }
            }
        },
        "singleInstance": {
            "description": "One running instance: a second launch hands its link to the first. Defaults to true when urlSchemes is not empty.",
            "type": "boolean"
        },
        "exclude": {
            "description": "Project-relative paths left out of the bundle.",
            "type": "array",
            "maxItems": 256,
            "items": { "type": "string" }
        },
        "extensions": {
            "description": "PHP extensions shipped in the bundle. Without this key, the shared extensions the application refers to. A list ships exactly the listed ones; \"auto\" in the list adds the ones the application refers to and \"all\" ships every shared extension loaded on the build machine.",
            "type": "array",
            "maxItems": 128,
            "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
        },
        "updates": {
            "type": "object",
            "required": ["endpoint", "publicKey"],
            "properties": {
                "endpoint": {
                    "description": "HTTPS URL of the signed feed.",
                    "type": "string",
                    "maxLength": 2048,
                    "pattern": "^https://"
                },
                "publicKey": {
                    "description": "Ed25519 public key, 64 lowercase hexadecimal characters.",
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "channel": {
                    "type": "string",
                    "default": "stable",
                    "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
                },
                "policy": {
                    "enum": ["manual", "notify", "automatic"],
                    "default": "manual"
                }
            },
            "additionalProperties": false
        }
    }
}
