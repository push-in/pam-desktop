{
    "name": "app/@SLUG@",
    "description": "@NAME@, a PAM Desktop application",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "pushinbr/pam-desktop": "^@VERSION@"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
